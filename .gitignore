# Build output. This is the 500+ MB that must never reach the repo.
/out/
/build/
third_party/rexglue-sdk/out/

# The user's game files. Never commit these - the project ships no game content.
/game_data/
/user_data/
/cache/
/package/
/release-package/
*.zip

# Runtime and debug leftovers.
/logs/
*.log
rex_log.txt
crash_dump.txt
*.pdb
*.bak

# Local settings written beside the executable at runtime.
/hydrothunder.toml

# Editor / OS noise.
.vs/
.vscode/
.idea/
__pycache__/
*.pyc
Thumbs.db
.DS_Store

# The rexglue SDK is NOT committed. It is ~700 MB with submodules, and because
# the clone carries its own .git, `git add` would record it as a gitlink with
# no .gitmodules entry - which clones down as an EMPTY directory and breaks the
# build with no useful error. Clone it yourself per BUILDING.md and apply
# patches/*.patch.
third_party/

# Pre-v0.10.0 codegen output, kept locally as a reference. ~122 MB.
/generated.0.8.1.19.bak/
